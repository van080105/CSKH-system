//   "presets": ["@babel/preset-env"],
//   "plugins": [
//     ["@babel/transform-runtime"],
//     ["module-resolver", { "alias": { "~": "./src" } }]
//   ]
// }
{
  "presets": ["@babel/preset-env"],
  "plugins": [
    "@babel/plugin-transform-runtime",
    ["module-resolver", {
      "root": ["./src"],
      "alias": {
        "@config": "./src/config",
        "@controllers": "./src/controllers",
        "@routes": "./src/routes",
        "@services": "./src/services"
      }
    }]
  ]
}

